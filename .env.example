# EyeAI environment. Copy to .env (docker compose reads it automatically). Every value has a default; only change what you need.
# The first block matters for any real deployment; the rest tunes the demo and the worker.

# ---- accounts and security ------------------------------------------------------------------------------------------
ADMIN_EMAIL=admin@eyeai.local          # first admin, created only when the users table is empty
ADMIN_PASSWORD=admin12345              # CHANGE for anything beyond local testing
AUTH_SECRET=dev-only-secret-change-me-please-32b   # session signing key, at least 32 random characters; CHANGE
# ADMIN_NAME=Administrator
# COOKIE_SECURE=1                      # set behind HTTPS so session cookies are Secure

# ---- migrations and seeds (run by the one-shot `migrate` service on every `docker compose up`) -------------------------
# Migrations are applied automatically and idempotently (checksummed, advisory-locked, safe with several replicas).
# The first admin is seeded when there are no users. The demo seed below runs ONCE per database when switched on:
SEED_DEMO=0                            # 1 = register the demo cameras DEMO-01..03 once (recorded in seed_runs; never again, never restored)
SEED_DEMO_UCF=0                        # 1 = also UCF-BURG / UCF-ASLT (needs scripts/fetch_ucf_clips.sh and FEED_STREAMS with burglary assault)
SEED_STREAM_BASE=rtsp://mediamtx:8554  # where the demo streams are served
# SKIP_MIGRATE=1                       # the app image migrates on boot unless this is set (compose sets it; the migrate service does the work)

# ---- demo video feed (compose profile `dev`) ------------------------------------------------------------------------
FEED_STREAMS=dock2 aisle gate          # subset of: dock2 aisle gate burglary assault

# ---- analysis (worker) ----------------------------------------------------------------------------------------------
EYEAI_TARGET_FPS=5                     # default analysed frames per second per camera (override per camera in the dashboard)
EYEAI_ORT_THREADS=                     # default CPU threads per camera; empty = automatic (override per camera in the dashboard)
# EYEAI_MODEL=/app/data/models/yolox_s.onnx   # detector weights inside the image
# EYEAI_POLL_S=5                       # how often the worker reads cameras and settings from the database
# EYEAI_STALL_S=10                     # seconds without a new frame before a stream counts as lost and reconnects
# WORKER_ID=worker-1
# RUST_LOG=info                        # info | debug | eyeai_engine::speed=debug

# ---- optional second AI check (leave CLASSIFIER_URL empty to run without it: no GPU, no extra model) --------------------
CLASSIFIER_URL=                        # e.g. http://classifier:11434 (Ollama serving a System One model); empty = off
CLASSIFIER_MODEL=d1
CLASSIFIER_TIMEOUT_S=60
# CLASSIFIER_BATCH=0 CLASSIFIER_RULES=1 CLASSIFIER_RULE_FRAMES=1 CLASSIFIER_RULE_MAX_QUEUE=10 CLASSIFIER_POLL_S=2 CLASSIFIER_MAX_ATTEMPTS=3
# (the rule settings can also be changed live in the dashboard)

# ---- ports ----------------------------------------------------------------------------------------------------------
APP_PORT=3000                          # dashboard
DB_PORT=5432                           # Postgres on the host
